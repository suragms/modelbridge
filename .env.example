# ===========================================
# ModelBridge Configuration
# ===========================================

# --- Database ---
DATABASE_URL=postgresql+asyncpg://modelbridge:modelbridge@localhost:5432/modelbridge

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Authentication ---
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# --- Encryption ---
ENCRYPTION_KEY=change-me-generate-with-fernet-generate-key

# --- Server ---
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:3000"]

# --- Provider API Keys (optional - configure via dashboard or env) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# --- Ollama ---
OLLAMA_BASE_URL=http://localhost:11434

# --- Logging ---
LOG_LEVEL=INFO
LOG_PROMPTS=false

# --- Rate Limiting (organization settings override via dashboard) ---
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_PER_DAY=10000

# --- Environment ---
ENVIRONMENT=development
